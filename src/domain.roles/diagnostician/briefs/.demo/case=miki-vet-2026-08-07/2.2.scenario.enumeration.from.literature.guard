artifacts:
  - $route/2.2.scenario.enumeration.from.literature.yield.md

reviews:
  self:
    - slug: has-bhrowser-citations
      say: |
        is every reported cause traced to a bhrowser-read source (never
        WebSearch/WebFetch), quoted verbatim with URL/PMID? an unbacked cause
        is a blocker (rule.require.bhrowser-citations).
    - slug: has-both-streams
      say: |
        did you pull BOTH formal (PMC/FDA/guideline) and social/anecdote
        sources, and read the comments (rule.require.read-social-comments)? one
        stream alone biases the lineup.
    - slug: has-accrued-facts
      say: |
        did you lift the generic cited facts into accrue/inventory.of=<topic>,
        case-neutral, separate from the yield (rule.require.accrue-research)?
        research trapped only in the yield is a blocker.

  peer:
    - bash -c ". .agent/repo=.this/role=any/skills/use.apikeys.sh && $rhachet run --repo bhrain --skill review --rules '.agent/**/rule.require.bhrowser-citations*.md' --rules '.agent/**/rule.require.accrue-research*.md' --paths '$route/2.2.scenario.enumeration.from.literature.yield.md' --paths '$route/accrue/*.md' --output '$route/.reviews/$stone.peer-review.citations.md'"

judges:
  - rhx route.stone.judge --mechanism reviewed? --stone $stone --route $route --allow-blockers 0 --allow-nitpicks 3
